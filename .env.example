# MHP Unified AI Super Agent Platform Environment Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (embedded file driver by default)
DATABASE_DRIVER="file"
DATABASE_URL="file:./mhp.db"
MHP_DATA_DIR="./data"

# Model Providers (Optional - MHP works locally without external keys)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="llama3"

# Cloud AI Provider Keys (User or System configured)
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_DEFAULT_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Video Engine Provider Keys (Optional - MOCK providers used when empty)
ELEVENLABS_API_KEY=""
REPLICATE_API_TOKEN=""
STABILITY_API_KEY=""
PEXELS_API_KEY=""
PIXABAY_API_KEY=""
JAMENDO_CLIENT_ID=""

# FFmpeg / FFprobe binaries (required for real MP4 rendering)
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# Security & Auth
APP_SECRET="mhp_super_agent_secret_key_2026_change_in_production"
AUTH_SECRET="mhp_auth_secret_change_in_production"
ALLOW_ANONYMOUS=true
ALLOWED_ORIGINS="http://localhost:3000"

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Video engine
MOCK_AI=true
MAX_CONCURRENT_JOBS=2
RENDER_TIMEOUT_MS=1800000
MHP_EXPORTS_DIR="./exports"
MHP_UPLOADS_DIR="./uploads"

# Workspace & execution
WORKSPACE_ROOT="./workspace"
EXECUTION_TIMEOUT_MS=30000
MAX_OUTPUT_BYTES=1048576
MAX_UPLOAD_BYTES=536870912